load("@rules_erlang//:erl_eval.bzl", "erl_eval")
load("@rules_erlang//:shell.bzl", "shell")

platform(
    name = "erlang_internal_platform",
    constraint_values = [
        "@erlang_config//:erlang_internal",
    ],
    parents = ["@rbe//config:platform"],
)

# @erlang_config no longer generates a major-only platform, and a
# repo-local label avoids https://github.com/bazelbuild/bazel/issues/14852
# in .bazelrc. @erlang_config//:erlang_26 is an alias of the 26.x value.
platform(
    name = "erlang_26_platform",
    constraint_values = [
        "@erlang_config//:erlang_26",
    ],
)

erl_eval(
    name = "otp_version",
    outs = ["otp_version.txt"],
    expression = """\
{ok, Version} =\
    file:read_file(\
        filename:join([\
            code:root_dir(),\
            "releases",\
            erlang:system_info(otp_release),\
            "OTP_VERSION"])\
    ),\
file:write_file(os:getenv("OUTS"), Version),\
halt().""",
)

shell(
    name = "repl",
)
